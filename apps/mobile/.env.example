EXPO_PUBLIC_API_URL=http://localhost:8000
EXPO_PUBLIC_AUTH_URL=http://localhost:8001
# Match the deployed backend PUBLIC_WEB_URL. Leave empty for custom-scheme and loopback web testing.
EXPO_PUBLIC_WEB_URL=
EXPO_PUBLIC_LINK_SCHEME=realtoruch
# Set a restricted Android Maps client key when validating an installed Android build.
GOOGLE_MAPS_ANDROID_API_KEY=
# Use your computer's LAN address instead of localhost on a physical phone.
# Set a licensed raster tile endpoint for public deployment.
EXPO_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
