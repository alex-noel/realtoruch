ENVIRONMENT=development
DEMO_MODE=false
DATABASE_URL=sqlite:///./realtoruch.db
AUTH_DATABASE_URL=sqlite:///./auth.db
AUTH_SERVICE_URL=http://localhost:8001
API_BASE_URL=http://localhost:8000
# Comma-separated verified account IDs; never accepted from a browser.
MODERATOR_USER_IDS=
CORS_ORIGINS=http://localhost:8081
# scripts/dev.py generates private local keys automatically.
# Set unique secrets and an RSA public/private key pair before deployment.
JWT_SECRET=local-demo-jwt-key-change-before-deployment-32-chars
PHONE_HASH_KEY=local-demo-phone-key-change-before-deployment
INTERNAL_API_KEY=local-demo-internal-key-change-before-deployment
CONNECTORS_CONFIG=config/sources.json
ELASTICSEARCH_URL=
SEARCH_SERVICE_URL=
# Local launchers default to private .local/mail/*.eml previews. To use SMTP,
# set .local/mail.env or shell variables; alerts/auth workers need credentials.
EMAIL_DELIVERY_MODE=disabled
EMAIL_FROM="Realtoruch <alerts@example.invalid>"
PUBLIC_WEB_URL=http://localhost:8081
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
# Optional device push. Email delivery does not require these.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
EXPO_PUSH_ENABLED=false
EXPO_PUSH_ACCESS_TOKEN=
