# Copy to .local/mail.env (ignored), chmod 600, then restart the local services.
# Set smtp only after replacing the host, sender and credentials.
EMAIL_DELIVERY_MODE=file
SMTP_HOST=your-smtp-host
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
EMAIL_FROM="Realtoruch <rentals@example.invalid>"
PUBLIC_WEB_URL=http://localhost:8081
